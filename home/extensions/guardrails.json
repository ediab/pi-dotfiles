{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.17.1/schema.json",
  "version": "0.17.1",
  "applyBuiltinDefaults": true,
  "onboarding": {
    "completed": true,
    "completedAt": "2026-09-11T03:58:28.367Z",
    "version": "0.17.1"
  },
  "features": {
    "pathAccess": false
  },
  "policies": {
    "rules": [
      {
        "id": "home-ssh",
        "description": "SSH private keys (config, known_hosts and public keys stay readable)",
        "enabled": true,
        "patterns": [
          { "pattern": "~/.ssh/**" },
          { "pattern": "~/.ssh/*_rsa" },
          { "pattern": "~/.ssh/*_ed25519" },
          { "pattern": "~/.ssh/*.pem" }
        ],
        "allowedPatterns": [
          { "pattern": "~/.ssh/config" },
          { "pattern": "~/.ssh/known_hosts" },
          { "pattern": "~/.ssh/*.pub" }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "blockMessage": "Accessing {file} is not allowed. This file is part of your SSH configuration and may contain private keys or sensitive host information."
      },
      {
        "id": "home-config",
        "description": "Sensitive user configuration directories",
        "enabled": true,
        "patterns": [
          { "pattern": "~/.config/gh/**" },
          { "pattern": "~/.config/gcloud/**" },
          { "pattern": "~/.config/op/**" },
          { "pattern": "~/.config/sops/**" }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "blockMessage": "Accessing {file} is not allowed. This file is in a sensitive user configuration directory and may contain credentials or tokens."
      },
      {
        "id": "home-gpg",
        "description": "GPG keys and configuration",
        "enabled": true,
        "patterns": [
          { "pattern": "~/.gnupg/**" },
          { "pattern": "~/*.gpg" },
          { "pattern": "~/.gpg-agent.conf" }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "blockMessage": "Accessing {file} is not allowed. This file is part of your GPG configuration and may contain private keys or trust settings."
      }
    ]
  },
  "permissionGate": {
    "allowedPatterns": [
      {
        "pattern": "\\brm\\b(?=[\\s\\S]*-[a-zA-Z]*[rR])(?=[\\s\\S]*-[a-zA-Z]*[fF])",
        "regex": true,
        "description": "Any recursive+force delete (rm -rf, rm -fr, rm -r -f, rm --recursive --force, /bin/rm, chained): never prompts"
      }
    ]
  }
}
