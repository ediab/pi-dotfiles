{
  "lastChangelogVersion": "0.83.0",
  "theme": "terminal",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:@ff-labs/pi-fff",
    "npm:pi-code-previews",
    "npm:pi-lsp",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-ponytail",
    "npm:pi-terminal-theme",
    "npm:@maxpaulus/pi-cline"
  ],
  "enableInstallTelemetry": true,
  "defaultProjectTrust": "always",
  "powerline": true,
  "breadcrumb": "inner",
  "header": true,
  "header-info": true,
  "quietStartup": true,
  "hideThinkingBlock": true,
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "medium"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high"
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "researcher": {
        "model": "opencode-go/glm-5.2",
        "thinking": "high"
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "max"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "high"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high"
      }
    },
    "watchdog": {
      "enabled": true,
      "main": {
        "enabled": true,
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "high"
      }
    }
  }
}